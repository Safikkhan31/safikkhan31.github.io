# Copy this file to .env and fill in real values. Never commit the real .env file.

# Server
PORT=5000

# MongoDB connection string.
# Local MongoDB:      mongodb://127.0.0.1:27017/ascent_game
# MongoDB Atlas:       mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ascent_game
MONGODB_URI=mongodb://127.0.0.1:27017/ascent_game

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API (your frontend URL(s)).
# Use * only for local testing, never in production.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
